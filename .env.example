# Пароль для входа на дашборд (один аккаунт)
ADMIN_PASSWORD=change-me

# Случайная длинная строка для подписи сессии входа.
# Сгенерировать можно так: openssl rand -base64 32
SESSION_SECRET=change-me

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me

# Секрет для защиты ежедневного cron-эндпоинта (Vercel сам подставит
# его в заголовок Authorization, если переменная называется CRON_SECRET)
CRON_SECRET=change-me
